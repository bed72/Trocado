{
  "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ],
            "enabled": true,
            "type": "local"
        },
        "lerd": {
            "command": [
                "lerd",
                "mcp"
            ],
            "enabled": true,
            "type": "local"
        }
    }
}
