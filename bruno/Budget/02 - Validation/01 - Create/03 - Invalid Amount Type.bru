meta {
  name: Create - Invalid Amount Type
  type: http
  seq: 3
  tags: [
    budget
    validation
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "amount": "12500",
        "start_date": "2026-09-01",
        "end_date": "2026-09-30"
      }
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("rejects an amount encoded as a string", function () {
    expect(res.getBody().errors[0].source.pointer).to.equal("/data/attributes/amount");
  });
}
