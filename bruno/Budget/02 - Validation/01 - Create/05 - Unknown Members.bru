meta {
  name: Create - Unknown Members
  type: http
  seq: 5
  tags: [
    budget
    validation
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "meta": {},
      "attributes": {
        "amount": 12500,
        "start_date": "2026-09-01",
        "end_date": "2026-09-30",
        "name": "Unexpected attribute"
      }
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("reports every unknown member", function () {
    const pointers = res.getBody().errors.map((error) => error.source.pointer);

    expect(pointers).to.include("/data");
    expect(pointers).to.include("/data/attributes");
  });
}
