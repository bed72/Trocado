meta {
  name: Update - Identifier Mismatch
  type: http
  seq: 2
  tags: [
    budget
    validation
  ]
}

patch {
  url: {{baseUrl}}/api/budgets/{{validationBudgetId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "id": "999999999",
      "attributes": {
        "amount": 30000
      }
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("points to the document identifier", function () {
    expect(res.getBody().errors[0].source.pointer).to.equal("/data/id");
  });
}
