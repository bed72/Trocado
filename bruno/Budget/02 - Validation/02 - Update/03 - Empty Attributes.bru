meta {
  name: Update - Empty Attributes
  type: http
  seq: 3
  tags: [
    budget
    validation
  ]
}

patch {
  url: {{baseUrl}}/api/budgets/{{validationBudgetId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "id": "{{validationBudgetId}}",
      "attributes": {}
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("points to the empty attributes object", function () {
    expect(res.getBody().errors[0].source.pointer).to.equal("/data/attributes");
  });
}
