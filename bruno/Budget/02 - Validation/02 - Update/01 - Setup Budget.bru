meta {
  name: Update Validation - Setup Budget
  type: http
  seq: 1
  tags: [
    budget
    validation
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "amount": 25000,
        "start_date": "2026-11-01",
        "end_date": "2026-11-30"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("validationBudgetId", res.getBody().data.id);
  }
}

tests {
  test("creates the validation target", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.id).to.be.a("string").and.not.be.empty;
  });
}
