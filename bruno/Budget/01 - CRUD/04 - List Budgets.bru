tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a JSON:API resource collection", function () {
    const body = res.getBody();

    expect(body.data).to.be.an("array");
    expect(body.data.some((budget) => budget.id === String(bru.getVar("budgetId")))).to.be.true;
  });
