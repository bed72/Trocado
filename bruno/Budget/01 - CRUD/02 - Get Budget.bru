meta {
  name: Get Budget
  type: http
  seq: 2
  tags: [
    budget
    crud
  ]
}

get {
  url: {{baseUrl}}/api/budgets/{{budgetId}}
  body: none
  auth: none
}


tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the budget created by the previous request", function () {
    const body = res.getBody();

    expect(body.data.type).to.equal("budgets");
    expect(body.data.id).to.equal(String(bru.getVar("budgetId")));
    expect(body.data.attributes.amount).to.equal(12500);
  });
}
