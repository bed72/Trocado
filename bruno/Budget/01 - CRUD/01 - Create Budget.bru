meta {
  name: Create Budget
  type: http
  seq: 1
  tags: [
    budget
    crud
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: inherit
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "amount": 12500,
        "start_date": "2026-09-01",
        "end_date": "2026-09-30"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("budgetId", res.getBody().data.id);
  }
}

tests {
  test("returns HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns a JSON:API budget resource", function () {
    const body = res.getBody();

    expect(body.data.type).to.equal("budgets");
    expect(body.data.id).to.be.a("string").and.not.be.empty;
    expect(body.data.attributes.amount).to.equal(12500);
  });

  test("returns JSON:API and Location headers", function () {
    expect(res.getHeader("content-type")).to.contain("application/vnd.api+json");
    expect(res.getHeader("location")).to.contain("/api/budgets/");
  });
}
