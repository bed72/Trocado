meta {
  name: Confirm Budget Deletion
  type: http
  seq: 6
  tags: [
    budget
    crud
  ]
}

get {
  url: {{baseUrl}}/api/budgets/{{budgetId}}
  body: none
  auth: inherit
}


tests {
  test("returns HTTP 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("returns the domain not-found error", function () {
    const error = res.getBody().errors[0];

    expect(error.status).to.equal("404");
    expect(error.title).to.equal("Budget n\u00e3o encontrado");
  });
}
