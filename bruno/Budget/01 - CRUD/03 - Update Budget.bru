meta {
  name: Update Budget
  type: http
  seq: 3
  tags: [
    budget
    crud
  ]
}

patch {
  url: {{baseUrl}}/api/budgets/{{budgetId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "id": "{{budgetId}}",
      "attributes": {
        "amount": 15000,
        "start_date": "2026-10-01",
        "end_date": "2026-10-31"
      }
    }
  }
}

tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the updated budget", function () {
    const body = res.getBody();

    expect(body.data.id).to.equal(String(bru.getVar("budgetId")));
    expect(body.data.attributes.amount).to.equal(15000);
    expect(body.data.attributes.start_date).to.equal("2026-10-01");
    expect(body.data.attributes.end_date).to.equal("2026-10-31");
  });
}
