meta {
  name: Reject Year Only Insights
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/insights?filter[year]=2026
  body: none
  auth: bearer
}

params:query {
  filter[year]: 2026
}

headers {
  Accept: application/vnd.api+json
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Retorna 422 JSON:API sem dados de sucesso", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("content-type")).to.match(/^application\/vnd\.api\+json(?:\s*;|$)/i);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).not.to.have.property("data");
    expect(body.errors).to.be.an("array").that.is.not.empty;
    body.errors.forEach(function (error) {
      expect(error).to.be.an("object");
      expect(error.status).to.equal("422");
    });
  });

  test("Identifica filter[month] ausente em source.parameter", function () {
    const errors = res.getBody().errors;
    expect(errors).to.be.an("array").that.is.not.empty;
    expect(errors.map(error => error.source?.parameter)).to.include("filter[month]");
  });
}

docs {
  Caso negativo: somente filter[year], sem filter[month].
  Ano isolado não seleciona o ano inteiro nem infere o mês vigente.
  Esperado: 422 JSON:API, errors com source.parameter igual a filter[month], sem data.

  Selecione um ambiente com baseUrl e accessToken de uma conta ativa/verificada.
  Mantenha somente o ano na aba Params para preservar o cenário de par incompleto.
  URL e params:query devem representar a mesma ocorrência de filter[year].
  A rejeição ocorre antes da leitura analítica, sem depender de despesas da conta.
}
