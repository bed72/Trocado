meta {
  name: Get Closed Month Insights
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/insights?filter[year]=2026&filter[month]=9
  body: none
  auth: bearer
}

params:query {
  filter[year]: 2026
  filter[month]: 9
}

headers {
  Accept: application/vnd.api+json
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  insightsQueryDate: 2026-10-15
}

tests {
  test("Retorna coleção JSON:API de Insights dentro do contrato", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.match(/^application\/vnd\.api\+json(?:\s*;|$)/i);
    const body = res.getBody();
    expect(body).to.be.an("object").and.not.to.have.property("errors");
    expect(body.data).to.be.an("array").with.length.at.most(6);
    expect(new Set(body.data.map(item => item.id)).size).to.equal(body.data.length);
    const types = {
      observation: ["category_concentration", "expense_concentration"],
      comparison: ["registered_amount_increase", "registered_amount_decrease", "category_lead_streak"],
      onboarding: ["first_expense", "insufficient_history", "category_review"]
    };
    body.data.forEach(function (item) {
      expect(item).to.have.all.keys("type", "id", "attributes");
      expect(item.type).to.equal("insights");
      expect(item.id).to.be.a("string").and.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
      expect(item.attributes).to.have.all.keys("group", "type", "title", "description", "period");
      const attributes = item.attributes;
      expect(types).to.have.property(attributes.group);
      expect(types[attributes.group]).to.include(attributes.type);
      expect(attributes.title).to.be.a("string").and.not.empty;
      expect(attributes.description).to.be.a("string").and.not.empty;
      const segmenter = new Intl.Segmenter("pt-BR", { granularity: "grapheme" });
      const length = text => Array.from(segmenter.segment(text)).length;
      const card = attributes.title + " " + attributes.description;
      expect(length(attributes.title)).to.be.at.most(24);
      expect(length(card)).to.be.at.most(80);
      expect(card).not.to.match(/%|\b(?:metade|dobrou)\b|por cento|um em cada dois|palco|pódio/iu);
      if (!['first_expense', 'insufficient_history'].includes(attributes.type)) {
        expect(attributes.description).to.match(/R\$ (?:0|[1-9][0-9.]*)(?:,[0-9]{2})?/u);
      }
    });
  });

  test("Preserva meses completos históricos e onboarding null", function () {
    const reference = bru.getRequestVar("insightsQueryDate");
    expect(reference).to.be.a("string").and.match(/^\d{4}-\d{2}-\d{2}$/);
    const [year, month, day] = reference.split("-").map(Number);
    const days = (y, m) => [31, y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1];
    expect(year).to.be.within(1, 9999);
    expect(month).to.be.within(1, 12);
    expect(day).to.be.within(1, days(year, month));
    const filters = Object.fromEntries(req.getQueryString().split("&").filter(Boolean).map(pair => pair.split("=").map(decodeURIComponent)));
    expect(filters).to.have.all.keys("filter[year]", "filter[month]");
    const selectedYear = Number(filters["filter[year]"]);
    const selectedMonth = Number(filters["filter[month]"]);
    expect(selectedYear).to.be.within(1, 9999);
    expect(selectedMonth).to.be.within(1, 12);
    const selectedIndex = selectedYear * 12 + selectedMonth - 1;
    expect(selectedIndex).to.be.at.least(14).and.below(year * 12 + month - 1);
    const offset = n => [Math.floor((selectedIndex + n) / 12), (selectedIndex + n) % 12 + 1];
    const civil = (y, m, d) => `${String(y).padStart(4, "0")}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    const start = civil(selectedYear, selectedMonth, 1);
    const end = civil(selectedYear, selectedMonth, days(selectedYear, selectedMonth));
    res.getBody().data.forEach(function ({ attributes }) {
      if (attributes.group === "onboarding") {
        expect(attributes.period).to.equal(null);
        expect(attributes.type).not.to.equal("first_expense");
        return;
      }
      expect(attributes.period).to.have.all.keys("from", "to", "comparison");
      if (["registered_amount_increase", "registered_amount_decrease"].includes(attributes.type)) {
        const [previousYear, previousMonth] = offset(-1);
        expect(attributes.period.from).to.equal(start);
        expect(attributes.period.to).to.equal(end);
        expect(attributes.period.comparison).to.have.all.keys("from", "to");
        expect(attributes.period.comparison.from).to.equal(civil(previousYear, previousMonth, 1));
        expect(attributes.period.comparison.to).to.equal(civil(previousYear, previousMonth, days(previousYear, previousMonth)));
        return;
      }
      const [firstYear, firstMonth] = offset(-2);
      expect(attributes.period.from).to.equal(attributes.type === "category_lead_streak" ? civil(firstYear, firstMonth, 1) : start);
      expect(attributes.period.to).to.equal(end);
      expect(attributes.period.comparison).to.equal(null);
    });
  });
}

docs {
  Catálogo v6-monetary-editorial: título e descrição somam até 80 grafemas,
  contando um espaço separador; título até 24. Valor BRL real e interpretação,
  sem porcentagem. Datas exatas ficam em period; texto usa referência natural.
  As assertions Unicode exigem Intl.Segmenter no runtime do Bruno.
  As verificações textuais não substituem revisão humana de tom/semântica.

  Antes das assertions, preencha insightsQueryDate na aba Vars com a data civil
  Y-m-d da aplicação no timezone de app.timezone. O valor 2026-10-14 é um exemplo
  explícito, local ao request e não enviado à API; atualize-o a cada consulta.

  Consulta histórica de setembro/2026 completo.
  Pré-condição: a data civil da aplicação, no timezone de app.timezone,
  deve ser 2026-10-01 ou posterior para setembro ser um mês encerrado.
  Durante setembro/2026, o mesmo par seleciona o vigente parcial;
  antes de setembro/2026, seleciona um mês futuro e retorna 422.

  As observações de setembro incluem 2026-09-01 a 2026-09-30.
  Quando elegível, a comparação usa setembro completo contra agosto completo
  (2026-08-01 a 2026-08-31), mesmo com quantidades diferentes de dias.
  A liderança recorrente considera julho, agosto e setembro, sem incluir outubro.

  A API não exige quantidade mínima de cartões nem comparação obrigatória.
  Onboarding conserva period: null e contextualiza setembro/2026;
  um mês vazio ou insuficiente não recebe first_expense na consulta histórica.
  A rotação das variantes usa o dia da consulta, não 30/09 como referência fixa.

  Selecione um ambiente com baseUrl e accessToken de uma conta ativa/verificada.
  Para consultar outro mês encerrado, altere filter[year] e filter[month] juntos
  na aba Params, respeitando a data civil da aplicação e o limite março/0001.

  No Bruno, edite os filtros na aba Params e deixe a URL sincronizar; não acrescente
  uma segunda ocorrência dos campos na URL. Ao editar o arquivo diretamente,
  mantenha o mesmo par na URL e em params:query, uma ocorrência por campo em cada.
}
