tests {
  test("returns HTTP 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("returns the recurrence not-found error", function () {
    expect(res.getBody().errors[0].title).to.equal("Recorr\u00eancia n\u00e3o encontrada");
  });
}
