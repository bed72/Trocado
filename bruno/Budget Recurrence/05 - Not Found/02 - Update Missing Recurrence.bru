meta {
  name: Update Missing Recurrence
  type: http
  seq: 2
  tags: [
    budget-recurrence
    not-found
  ]
}

patch {
  url: {{baseUrl}}/api/budget-recurrences/{{notFoundRecurrenceId}}
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budget-recurrences",
      "id": "{{notFoundRecurrenceId}}",
      "attributes": {
        "amount": 1000
      }
    }
  }
}

tests {
  test("returns HTTP 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("returns the recurrence not-found error", function () {
    expect(res.getBody().errors[0].title).to.equal("Recorr\u00eancia n\u00e3o encontrada");
  });
}
