meta {
  name: Create - Unknown Recurrence Attribute
  type: http
  seq: 2
  tags: [
    budget-recurrence
    validation
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "amount": 50000,
        "start_date": "2031-01-01",
        "end_date": "2031-01-07",
        "recurring": true,
        "frequency": "weekly"
      }
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("points to the attributes object", function () {
    expect(res.getBody().errors[0].source.pointer).to.equal("/data/attributes");
  });
}
