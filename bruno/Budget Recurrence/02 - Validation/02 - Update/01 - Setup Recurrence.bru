meta {
  name: Update Validation - Setup Recurrence
  type: http
  seq: 1
  tags: [
    budget-recurrence
    validation
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "amount": 75000,
        "start_date": "2031-02-01",
        "end_date": "2031-02-07",
        "recurring": true
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();

    bru.setVar("validationRecurringBudgetId", body.data.id);
    bru.setVar("validationRecurrenceId", body.data.relationships.recurrence.data.id);
  }
}

tests {
  test("creates the validation target", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.relationships.recurrence.data.id).to.be.a("string").and.not.be.empty;
  });
}
