meta {
  name: Update - Invalid Duration
  type: http
  seq: 4
  tags: [
    budget-recurrence
    validation
  ]
}

patch {
  url: {{baseUrl}}/api/budget-recurrences/{{validationRecurrenceId}}
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budget-recurrences",
      "id": "{{validationRecurrenceId}}",
      "attributes": {
        "duration_in_days": 0
      }
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("points to the duration attribute", function () {
    expect(res.getBody().errors[0].source.pointer).to.equal("/data/attributes/duration_in_days");
  });
}
