meta {
  name: Invalid Transitions - Setup Active Recurrence
  type: http
  seq: 1
  tags: [
    budget-recurrence
    transition
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "amount": 110000,
        "start_date": "2033-01-01",
        "end_date": "2033-01-07",
        "recurring": true
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();

    bru.setVar("transitionBudgetId", body.data.id);
    bru.setVar("transitionRecurrenceId", body.data.relationships.recurrence.data.id);
  }
}

tests {
  test("creates an active recurrence", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.relationships.recurrence.data.id).to.be.a("string").and.not.be.empty;
  });
}
