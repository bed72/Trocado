meta {
  name: Invalid Transitions - Setup Active Recurrence
  type: http
  seq: 1
  tags: [
    budget-recurrence
    transition
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

script:pre-request {
  const dayInMilliseconds = 24 * 60 * 60 * 1000;
  const offset = (Date.now() + Math.floor(Math.random() * 36500)) % 36500;
  const startDate = new Date(Date.UTC(2100, 0, 1) + offset * dayInMilliseconds);
  const endDate = new Date(startDate.getTime() + 6 * dayInMilliseconds);

  bru.setVar("transitionStartDate", startDate.toISOString().slice(0, 10));
  bru.setVar("transitionEndDate", endDate.toISOString().slice(0, 10));
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "amount": 110000,
        "start_date": "{{transitionStartDate}}",
        "end_date": "{{transitionEndDate}}",
        "recurring": true
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();

    bru.setVar("transitionBudgetId", body.data.id);
    bru.setVar("transitionRecurrenceId", body.data.relationships.recurrence.data.id);
  }
}

tests {
  test("creates an active recurrence", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.relationships.recurrence.data.id).to.be.a("string").and.not.be.empty;
  });
}
