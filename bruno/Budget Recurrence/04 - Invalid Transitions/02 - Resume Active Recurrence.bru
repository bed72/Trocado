meta {
  name: Resume Active Recurrence
  type: http
  seq: 2
  tags: [
    budget-recurrence
    transition
    conflict
  ]
}

post {
  url: {{baseUrl}}/api/budget-recurrences/{{transitionRecurrenceId}}/resume
  body: none
  auth: none
}

headers {
  Accept: application/vnd.api+json
}

tests {
  test("returns HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("reports that only blocked recurrences can resume", function () {
    const error = res.getBody().errors[0];

    expect(error.status).to.equal("409");
    expect(error.title).to.equal("Transi\u00e7\u00e3o de recorr\u00eancia inv\u00e1lida");
    expect(error.detail).to.contain("bloqueada");
  });
}
