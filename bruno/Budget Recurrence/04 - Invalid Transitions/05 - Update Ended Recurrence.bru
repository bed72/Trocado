meta {
  name: Update Ended Recurrence
  type: http
  seq: 5
  tags: [
    budget-recurrence
    transition
    conflict
  ]
}

patch {
  url: {{baseUrl}}/api/budget-recurrences/{{transitionRecurrenceId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budget-recurrences",
      "id": "{{transitionRecurrenceId}}",
      "attributes": {
        "amount": 120000
      }
    }
  }
}

tests {
  test("returns HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("does not alter an ended recurrence", function () {
    const error = res.getBody().errors[0];

    expect(error.title).to.equal("Transi\u00e7\u00e3o de recorr\u00eancia inv\u00e1lida");
    expect(error.detail).to.contain("encerrada");
  });
}

docs {
  Demonstra que uma recorrência encerrada não aceita novas alterações de template. O `amount` enviado não é aplicado e a API responde `409`.
}
