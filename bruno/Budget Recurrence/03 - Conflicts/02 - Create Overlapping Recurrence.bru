meta {
  name: Create Overlapping Recurrence
  type: http
  seq: 2
  tags: [
    budget-recurrence
    conflict
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "amount": 95000,
        "start_date": "2032-01-07",
        "end_date": "2032-01-14",
        "recurring": true
      }
    }
  }
}

tests {
  test("returns HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("returns the date conflict error", function () {
    const error = res.getBody().errors[0];

    expect(error.status).to.equal("409");
    expect(error.title).to.equal("Conflito de datas");
    expect(error.detail).to.contain("se sobrep\u00f5e");
  });
}
