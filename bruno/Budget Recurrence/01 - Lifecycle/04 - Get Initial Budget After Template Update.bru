meta {
  name: Get Initial Budget After Template Update
  type: http
  seq: 4
  tags: [
    budget-recurrence
    lifecycle
  ]
}

get {
  url: {{baseUrl}}/api/budgets/{{recurringBudgetId}}
  body: none
  auth: inherit
}


tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("does not change the existing budget", function () {
    const body = res.getBody();

    expect(body.data.id).to.equal(String(bru.getVar("recurringBudgetId")));
    expect(body.data.attributes.amount).to.equal(100000);
    expect(body.data.attributes.start_date).to.equal("2030-01-01");
    expect(body.data.attributes.end_date).to.equal("2030-01-07");
    expect(body.data.relationships.recurrence.data.id).to.equal(String(bru.getVar("recurrenceId")));
  });
}
