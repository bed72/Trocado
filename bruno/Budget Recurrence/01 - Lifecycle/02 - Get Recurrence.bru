meta {
  name: Get Recurrence
  type: http
  seq: 2
  tags: [
    budget-recurrence
    lifecycle
  ]
}

get {
  url: {{baseUrl}}/api/budget-recurrences/{{recurrenceId}}
  body: none
  auth: none
}


tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the active recurrence template", function () {
    const body = res.getBody();

    expect(body.data.type).to.equal("budget-recurrences");
    expect(body.data.id).to.equal(String(bru.getVar("recurrenceId")));
    expect(body.data.attributes.status).to.equal("active");
    expect(body.data.attributes.amount).to.equal(100000);
    expect(body.data.attributes.duration_in_days).to.equal(7);
    expect(body.data.attributes.next_start_date).to.equal("2030-01-08");
  });

  test("returns the JSON:API content type", function () {
    expect(res.getHeader("content-type")).to.contain("application/vnd.api+json");
  });
}
