meta {
  name: Resume Ended Recurrence
  type: http
  seq: 6
  tags: [
    budget-recurrence
    lifecycle
    conflict
  ]
}

post {
  url: {{baseUrl}}/api/budget-recurrences/{{recurrenceId}}/resume
  body: none
  auth: none
}

headers {
  Accept: application/vnd.api+json
}

tests {
  test("returns HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("returns the invalid transition error", function () {
    const error = res.getBody().errors[0];

    expect(error.status).to.equal("409");
    expect(error.title).to.equal("Transi\u00e7\u00e3o de recorr\u00eancia inv\u00e1lida");
  });
}
