meta {
  name: Create Recurring Budget
  type: http
  seq: 1
  tags: [
    budget-recurrence
    lifecycle
  ]
}

post {
  url: {{baseUrl}}/api/budgets
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "amount": 100000,
        "start_date": "2030-01-01",
        "end_date": "2030-01-07",
        "recurring": true
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();

    bru.setVar("recurringBudgetId", body.data.id);
    bru.setVar("recurrenceId", body.data.relationships.recurrence.data.id);
  }
}

tests {
  test("returns HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the recurring budget relationship", function () {
    const body = res.getBody();

    expect(body.data.type).to.equal("budgets");
    expect(body.data.id).to.be.a("string").and.not.be.empty;
    expect(body.data.attributes.amount).to.equal(100000);
    expect(body.data.relationships.recurrence.data.type).to.equal("budget-recurrences");
    expect(body.data.relationships.recurrence.data.id).to.be.a("string").and.not.be.empty;
  });

  test("returns JSON:API and Location headers", function () {
    expect(res.getHeader("content-type")).to.contain("application/vnd.api+json");
    expect(res.getHeader("location")).to.contain("/api/budgets/");
  });
}
