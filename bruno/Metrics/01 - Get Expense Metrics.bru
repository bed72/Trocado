meta {
  name: Get Expense Metrics
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/metrics/expenses?group_by=category&end_date=2026-10-31&start_date=2026-10-01
  body: none
  auth: bearer
}

params:query {
  group_by: category
  end_date: 2026-10-31
  start_date: 2026-10-01
}

headers {
  Accept: application/vnd.api+json
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  O agrupamento aceita todos os dezoito identificadores do catálogo, incluindo as oito categorias novas, sem nomes traduzidos ou categorias ausentes com zero.
  No período selecionado, investments 60000, financing 30000 e food 10000 produzem total_amount 100000 e percentage 60.00, 30.00 e 10.00.
  Remova group_by para o total simples. Empates entre financing, investments e travel seguem essa ordem alfabética.
}

tests {
  test("Resumo, inclusive zero, conserva UUID por owner/período/modo", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.type).to.equal("expense-metrics");
    const attributes = data.attributes;
    expect(attributes.total_amount).to.match(/^(0|[1-9][0-9]*)$/);
    const mode = Object.prototype.hasOwnProperty.call(attributes, "categories") ? "category" : "total";
    if (mode === "category") {
      expect(attributes.categories).to.be.an("array");
      attributes.categories.forEach(category => expect(category).not.to.have.property("id"));
    }
    const key = ["metrics-baseline", bru.getVar("userId"), attributes.start_date, attributes.end_date, mode].join(".");
    const previous = bru.getVar(key);
    if (previous) expect(data.id).to.equal(previous);
    bru.setVar(key, data.id);
  });
}
