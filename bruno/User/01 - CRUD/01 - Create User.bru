meta {
  name: Create User
  type: http
  seq: 1
  tags: [
    user
    crud
  ]
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "users",
      "attributes": {
        "name": "  Maria Silva  ",
        "email": "  BRUNO.USER.CRUD@EXAMPLE.COM  "
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("userId", res.getBody().data.id);
  }
}

tests {
  test("returns HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns a canonical JSON:API user resource", function () {
    const body = res.getBody();

    expect(body.data.type).to.equal("users");
    expect(body.data.id).to.be.a("string").and.not.be.empty;
    expect(body.data.attributes.name).to.equal("Maria Silva");
    expect(body.data.attributes.email).to.equal("bruno.user.crud@example.com");
    expect(body.data.attributes.created_at).to.be.a("string");
    expect(body.data.attributes.updated_at).to.be.a("string");
  });

  test("returns JSON:API and Location headers", function () {
    expect(res.getHeader("content-type")).to.contain("application/vnd.api+json");
    expect(res.getHeader("location")).to.contain("/api/users/");
  });
}
