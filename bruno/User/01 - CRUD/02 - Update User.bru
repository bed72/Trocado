meta {
  name: Update User
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "users",
      "id": "{{userId}}",
      "attributes": {
        "name": "Maria Silva",
        "avatar": "a3f79c0241b86e50d9c217fa6830be45"
      }
    }
  }
}

tests {
  test("Edição conserva UUID do owner", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.id).to.equal(bru.getVar("userId").toLowerCase());
  });
}
