meta {
  name: Update User
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "users",
      "id": "{{userId}}",
      "attributes": {
        "name": "Maria Silva",
        "email": "maria.silva@example.com"
      }
    }
  }
}
