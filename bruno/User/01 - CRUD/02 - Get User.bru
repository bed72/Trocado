meta {
  name: Get User
  type: http
  seq: 4
  tags: [
    user
    crud
  ]
}

get {
  url: {{baseUrl}}/api/users/{{userId}}
  body: none
  auth: inherit
}


tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the user created by the previous request", function () {
    const body = res.getBody();

    expect(body.data.type).to.equal("users");
    expect(body.data.id).to.equal(String(bru.getVar("userId")));
    expect(body.data.attributes.name).to.equal("Maria Silva");
    expect(body.data.attributes.email).to.equal(bru.getVar("userEmail"));
  });
}
