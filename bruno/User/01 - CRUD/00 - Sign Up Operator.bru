meta {
  name: Sign Up Operator
  type: http
  seq: 1
  tags: [
    user
    crud
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

script:pre-request {
  const runId = `${Date.now()}${Math.floor(Math.random() * 1000000).toString().padStart(6, "0")}`;

  bru.setVar("userOperatorEmail", `bruno.user.operator.${runId}@example.com`);
  bru.setVar("userOperatorPassword", `B${runId.slice(-8)}x`);
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "CRUD Operator",
        "email": "{{userOperatorEmail}}",
        "password": "{{userOperatorPassword}}",
        "password_confirmation": "{{userOperatorPassword}}"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("userOperatorId", res.getBody().data.relationships.user.data.id);
  }
}

tests {
  test("creates the operator through SignUp without Bearer", function () {
    const authorization = req.headers.authorization ?? req.headers.Authorization;

    expect(authorization).to.equal(undefined);
    expect(res.getStatus()).to.equal(201);
  });
}
