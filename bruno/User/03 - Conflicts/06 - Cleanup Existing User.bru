meta {
  name: Conflict - Cleanup Existing User
  type: http
  seq: 7
  tags: [
    user
    conflict
    cleanup
  ]
}

delete {
  url: {{baseUrl}}/api/users/{{conflictUserId}}
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.deleteVar("authenticationToken");
    bru.deleteVar("conflictUserId");
    bru.deleteVar("conflictUserEmail");
    bru.deleteVar("conflictUserPassword");
  }
}

tests {
  test("removes the existing user", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
