meta {
  name: Conflict - Duplicate SignUp Email
  type: http
  seq: 3
  tags: [
    user
    conflict
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "Dup User",
        "email": " {{conflictUserEmail}} ",
        "password": "{{conflictUserPassword}}",
        "password_confirmation": "{{conflictUserPassword}}"
      }
    }
  }
}

tests {
  test("returns HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("returns the canonical email conflict", function () {
    const error = res.getBody().errors[0];

    expect(error.status).to.equal("409");
    expect(error.title).to.equal("E-mail j\u00e1 utilizado");
    expect(error.detail).to.equal("N\u00e3o foi poss\u00edvel utilizar o e-mail informado.");
  });
}

docs {
  Verifica o conflito no único caminho de criação de conta, `POST /api/authentication/sign-up`, usando somente credenciais de runtime.
}
