meta {
  name: Conflict - Setup Update Target
  type: http
  seq: 4
  tags: [
    user
    conflict
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

script:pre-request {
  const runId = `${Date.now()}${Math.floor(Math.random() * 1000000).toString().padStart(6, "0")}`;

  bru.setVar("conflictTargetUserEmail", `bruno.user.conflict-target.${runId}@example.com`);
  bru.setVar("conflictTargetUserPassword", `F${runId.slice(-8)}x`);
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "Update Target",
        "email": "{{conflictTargetUserEmail}}",
        "password": "{{conflictTargetUserPassword}}",
        "password_confirmation": "{{conflictTargetUserPassword}}"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("conflictTargetUserId", res.getBody().data.relationships.user.data.id);
  }
}

tests {
  test("creates the update target", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
