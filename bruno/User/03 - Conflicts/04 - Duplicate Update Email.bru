meta {
  name: Conflict - Duplicate Update Email
  type: http
  seq: 4
  tags: [
    user
    conflict
  ]
}

patch {
  url: {{baseUrl}}/api/users/{{conflictTargetUserId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "users",
      "id": "{{conflictTargetUserId}}",
      "attributes": {
        "email": " BRUNO.USER.CONFLICT@EXAMPLE.COM "
      }
    }
  }
}

tests {
  test("returns HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("does not expose a database exception", function () {
    const error = res.getBody().errors[0];

    expect(error.status).to.equal("409");
    expect(error.title).to.equal("E-mail j\u00e1 utilizado");
    expect(error.detail).not.to.contain("SQL");
  });
}
