meta {
  name: Conflict - Setup Existing User
  type: http
  seq: 1
  tags: [
    user
    conflict
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

script:pre-request {
  const runId = `${Date.now()}${Math.floor(Math.random() * 1000000).toString().padStart(6, "0")}`;

  bru.setVar("conflictUserEmail", `bruno.user.conflict.${runId}@example.com`);
  bru.setVar("conflictUserPassword", `E${runId.slice(-8)}x`);
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "Existing User",
        "email": "{{conflictUserEmail}}",
        "password": "{{conflictUserPassword}}",
        "password_confirmation": "{{conflictUserPassword}}"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("conflictUserId", res.getBody().data.relationships.user.data.id);
  }
}

tests {
  test("creates the existing user", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
