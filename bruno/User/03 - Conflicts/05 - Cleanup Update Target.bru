meta {
  name: Conflict - Cleanup Update Target
  type: http
  seq: 6
  tags: [
    user
    conflict
    cleanup
  ]
}

delete {
  url: {{baseUrl}}/api/users/{{conflictTargetUserId}}
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.deleteVar("conflictTargetUserId");
    bru.deleteVar("conflictTargetUserEmail");
    bru.deleteVar("conflictTargetUserPassword");
  }
}

tests {
  test("removes the update target", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
