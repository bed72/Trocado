meta {
  name: Not Found - Sign Up Operator
  type: http
  seq: 1
  tags: [
    user
    not-found
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

script:pre-request {
  const runId = `${Date.now()}${Math.floor(Math.random() * 1000000).toString().padStart(6, "0")}`;

  bru.setVar("notFoundOperatorEmail", `bruno.user.not-found.${runId}@example.com`);
  bru.setVar("notFoundOperatorPassword", `G${runId.slice(-8)}x`);
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "NF Operator",
        "email": "{{notFoundOperatorEmail}}",
        "password": "{{notFoundOperatorPassword}}",
        "password_confirmation": "{{notFoundOperatorPassword}}"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("notFoundOperatorId", res.getBody().data.relationships.user.data.id);
  }
}

tests {
  test("creates the operator through SignUp", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
