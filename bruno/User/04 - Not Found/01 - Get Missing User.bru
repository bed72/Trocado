get {
  url: {{baseUrl}}/api/users/{{notFoundUserId}}
  body: none
  auth: none
}


tests {
  test("returns HTTP 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("returns the user not-found error", function () {
    const error = res.getBody().errors[0];

    expect(error.status).to.equal("404");
    expect(error.title).to.equal("User n\u00e3o encontrado");
  });
}
