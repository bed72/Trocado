meta {
  name: Update Missing User
  type: http
  seq: 3
  tags: [
    user
    not-found
  ]
}

patch {
  url: {{baseUrl}}/api/users/{{notFoundUserId}}
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "users",
      "id": "{{notFoundUserId}}",
      "attributes": {
        "name": "Missing User"
      }
    }
  }
}

tests {
  test("returns HTTP 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("returns the user not-found error", function () {
    expect(res.getBody().errors[0].title).to.equal("User n\u00e3o encontrado");
  });
}
