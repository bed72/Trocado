meta {
  name: Not Found - Cleanup Operator
  type: http
  seq: 7
  tags: [
    user
    not-found
    cleanup
  ]
}

delete {
  url: {{baseUrl}}/api/users/{{notFoundOperatorId}}
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.deleteVar("authenticationToken");
    bru.deleteVar("notFoundOperatorId");
    bru.deleteVar("notFoundOperatorEmail");
    bru.deleteVar("notFoundOperatorPassword");
  }
}

tests {
  test("removes the authenticated operator", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
