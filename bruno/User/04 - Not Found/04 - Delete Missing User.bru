tests {
  test("returns HTTP 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("returns the user not-found error", function () {
    expect(res.getBody().errors[0].title).to.equal("User n\u00e3o encontrado");
  });
}
