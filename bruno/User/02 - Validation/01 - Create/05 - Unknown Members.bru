meta {
  name: Create - Unknown Members
  type: http
  seq: 5
  tags: [
    user
    validation
  ]
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "users",
      "meta": {},
      "attributes": {
        "name": "Maria",
        "email": "unknown-members@example.com",
        "password": "not-accepted"
      }
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("rejects unknown JSON:API members", function () {
    const pointers = res.getBody().errors.map((error) => error.source.pointer);

    expect(pointers).to.include("/data");
    expect(pointers).to.include("/data/attributes");
  });
}
