meta {
  name: Create - Wrong Resource Type
  type: http
  seq: 1
  tags: [
    user
    validation
  ]
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "budgets",
      "attributes": {
        "name": "Maria",
        "email": "wrong-type@example.com"
      }
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("points to the resource type", function () {
    expect(res.getBody().errors[0].source.pointer).to.equal("/data/type");
  });
}
