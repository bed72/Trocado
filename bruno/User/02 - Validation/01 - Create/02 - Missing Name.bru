meta {
  name: Create - Missing Name
  type: http
  seq: 2
  tags: [
    user
    validation
  ]
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "users",
      "attributes": {
        "email": "missing-name@example.com"
      }
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("points to the missing name", function () {
    expect(res.getBody().errors[0].source.pointer).to.equal("/data/attributes/name");
  });
}
