meta {
  name: Update - Unknown Attribute
  type: http
  seq: 6
  tags: [
    user
    validation
  ]
}

patch {
  url: {{baseUrl}}/api/users/{{validationUserId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "users",
      "id": "{{validationUserId}}",
      "attributes": {
        "unknown": true
      }
    }
  }
}

tests {
  test("returns HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("points to the attributes object", function () {
    expect(res.getBody().errors[0].source.pointer).to.equal("/data/attributes");
  });
}
