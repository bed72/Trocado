meta {
  name: Update Validation - Setup User
  type: http
  seq: 1
  tags: [
    user
    validation
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

script:pre-request {
  const runId = `${Date.now()}${Math.floor(Math.random() * 1000000).toString().padStart(6, "0")}`;

  bru.setVar("validationUserEmail", `bruno.user.validation.${runId}@example.com`);
  bru.setVar("validationUserPassword", `D${runId.slice(-8)}x`);
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "Valid User",
        "email": "{{validationUserEmail}}",
        "password": "{{validationUserPassword}}",
        "password_confirmation": "{{validationUserPassword}}"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("validationUserId", res.getBody().data.relationships.user.data.id);
  }
}

tests {
  test("creates the validation target", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.id).to.be.a("string").and.not.be.empty;
  });
}
