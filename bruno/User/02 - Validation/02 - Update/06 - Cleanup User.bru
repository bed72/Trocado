meta {
  name: Update Validation - Cleanup User
  type: http
  seq: 7
  tags: [
    user
    validation
    cleanup
  ]
}

delete {
  url: {{baseUrl}}/api/users/{{validationUserId}}
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.deleteVar("authenticationToken");
    bru.deleteVar("validationUserId");
    bru.deleteVar("validationUserEmail");
    bru.deleteVar("validationUserPassword");
  }
}

tests {
  test("removes the validation target", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
