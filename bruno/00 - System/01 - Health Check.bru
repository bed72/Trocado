meta {
  name: Health Check
  type: http
  seq: 1
  tags: [
    smoke
    system
  ]
}

get {
  url: {{baseUrl}}/up
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("reports the application as up", function () {
    expect(res.getBody()).to.deep.equal({ status: "up" });
  });
}
