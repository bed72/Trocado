meta {
  name: Create Expense
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/expenses
  body: json
  auth: bearer
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "data": {
      "type": "expenses",
      "attributes": {
        "amount": 80,
        "occurred_on": "2026-10-01",
        "category": "travel",
        "description": "Passagem aérea para as férias"
      }
    }
  }
}

script:post-response {
  const expenseId = res.body?.data?.id;
  
  if (res.status === 201 && typeof expenseId === 'string' && expenseId.length > 0) {
    bru.setVar('expenseId', expenseId);
  }
}

docs {
  Exemplo de categoria explícita `travel`: a criação retorna e persiste esse identificador sem enviar a descrição à IA.
  As novas categorias também incluem financing, investments, taxes, insurance, personal_care, pets e gifts_and_donations.
  Remova category para exercitar o fluxo existente: criação em other e classificação futura somente com descrição elegível.
}
