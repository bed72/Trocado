meta {
  name: Create Expense
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/expenses
  body: json
  auth: bearer
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "data": {
      "type": "expenses",
      "attributes": {
        "amount": 7200,
        "occurred_on": "2026-09-26",
        "description": "Padaria"
      }
    }
  }
}

script:post-response {
  const expenseId = res.body?.data?.id;
  
  if (res.status === 201 && typeof expenseId === 'string' && expenseId.length > 0) {
    bru.setVar('expenseId', expenseId);
  }
}
