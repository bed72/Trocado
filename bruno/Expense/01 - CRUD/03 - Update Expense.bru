meta {
  name: Update Expense
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/expenses/{{expenseId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "expenses",
      "attributes": {
        "amount": 1500,
        "description": "Ônibus e metrô"
      }
    }
  }
}
