meta {
  name: GetAll Expense
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/expenses?page[size]=50
  body: none
  auth: bearer
}

params:query {
  page[size]: 50
  ~page[cursor]: {{expenseCursor}}
  ~filter[year]: 2026
  ~filter[month]: 9
  ~filter[day]: 15
  ~filter[from]: 2026-09-01
  ~filter[to]: 2026-09-30
  ~filter[category]: travel,investments,food,travel
  ~filter[amount_min]: 1000
  ~filter[amount_max]: 30000
  ~sort: -occurred_on,amount
}

headers {
  Accept: application/vnd.api+json
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  expenseCursor: https://trocado.test/api/expenses?page%5Bsize%5D=50&page%5Bcursor%5D=eyJ2IjoyLCJxdWVyeSI6IjA3MDkwOTY4NWMyODQ2MzUzMmQ5Y2QyYjQ4ZTU2OGI3MzBjMDU5NmZjZDRmODAzNjI4NGIxYzk5MjQ3YzQwMWMiLCJwb3NpdGlvbiI6eyJvY2N1cnJlZF9vbiI6IjIwMjYtMTAtMTYiLCJpZCI6IjAxYTE0NTI0LWJhZWUtNzI5My1iYWQ2LTZlYWUzNmViYmI1OSJ9LCJmb3J3YXJkIjp0cnVlfQ
}

docs {
  O conjunto travel,investments,food,travel normaliza para food,investments,travel.
  Categorias combinam por OU; proprietário, datas e limites de valor combinam por E antes da paginação.
  Ajuste o período para os registros que deseja consultar. Valores fora do catálogo, inclusive travel,unknown, retornam 422.
}
