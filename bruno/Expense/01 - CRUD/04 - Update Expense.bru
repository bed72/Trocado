meta {
  name: Update Expense
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/expenses/{{expenseId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "expenses",
      "attributes": {
        "amount": 1500,
        "category": "investments",
        "description": "Aporte em renda fixa"
      }
    }
  }
}

docs {
  A edição escolhe investments explicitamente e cancela uma eventual classificação pendente anterior.
  Aportes participam de Metrics e Insights como valores registrados, sem inferência de retorno ou consumo.
}
