meta {
  name: Cleanup User
  type: http
  seq: 9
  tags: [
    smoke
    authentication
    cleanup
  ]
}

delete {
  url: {{baseUrl}}/api/users/{{authenticationUserId}}
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.deleteVar("authenticationUserId");
    bru.deleteVar("authenticationToken");
    bru.deleteVar("authenticationEmail");
    bru.deleteVar("authenticationPassword");
    bru.deleteVar("authenticationInvalidPassword");
  }
}

tests {
  test("removes the sign up user", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
