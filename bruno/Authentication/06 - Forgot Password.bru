meta {
  name: Forgot Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/authentication/forgot-password
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "password-recovery-requests",
      "attributes": {
        "email": "{{authEmail}}"
      }
    }
  }
}

docs {
  Configure authEmail no armazenamento privado do Bruno e execute somente este request.
  O 202 é genérico: não confirma existência da conta, emissão ou entrega do e-mail.
  Apenas conta ativa e verificada pode receber recuperação; configure PASSWORD_RESET_URL, mailer e worker Redis no servidor.
  Copie o token do link recebido para a variável secreta passwordResetToken, sem abrir o destino por esta coleção.
  O link vale 30 minutos; nova emissão admitida após 60 segundos invalida o anterior.
  Cota própria: 6 requests por IP a cada 10 minutos, inclusive inválidos; exceder retorna 429 com Retry-After.
}

tests {
  test("Solicitação retorna 202 JSON API genérico sem credenciais", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("content-type")).to.include("application/vnd.api+json");
    expect(res.getBody()).to.deep.equal({
      meta: { message: "Se a conta estiver apta, enviaremos as instruções de recuperação." }
    });
  });
}
