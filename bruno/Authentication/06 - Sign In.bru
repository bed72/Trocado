meta {
  name: Sign In
  type: http
  seq: 6
  tags: [
    smoke
    authentication
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-in
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "access-tokens",
      "attributes": {
        "email": "{{authenticationEmail}}",
        "password": "{{authenticationPassword}}"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("authenticationToken", res.getBody().data.attributes.token);
  }
}

tests {
  test("returns a Bearer token without cache", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body.data.type).to.equal("access-tokens");
    expect(body.data.attributes.token).to.be.a("string").and.not.be.empty;
    expect(body.data.attributes.token_type).to.equal("Bearer");
    expect(body.data.attributes.expires_at).to.be.a("string").and.not.be.empty;
    expect(body.data.relationships.user.data.id).to.equal(bru.getVar("authenticationUserId"));
    expect(res.getHeader("cache-control")).to.contain("no-store");
    expect(res.getHeader("pragma")).to.contain("no-cache");
  });
}

docs {
  A resposta expõe o token Bearer somente neste login. O script pós-resposta o mantém como variável de runtime `authenticationToken` para os requests seguintes; não copie o valor para a collection, para um ambiente ou para documentação.
}
