meta {
  name: Sign Up
  type: http
  seq: 1
  tags: [
    smoke
    authentication
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

script:pre-request {
  if (!bru.getVar("authenticationEmail")) {
    const runId = `${Date.now()}${Math.floor(Math.random() * 1000000).toString().padStart(6, "0")}`;

    bru.setVar("authenticationEmail", `authentication.bruno.${runId}@example.com`);
    bru.setVar("authenticationPassword", `B${runId.slice(-8)}x`);
    bru.setVar("authenticationInvalidPassword", `C${runId.slice(-8)}y`);
  }
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "Authentication Bruno",
        "email": "{{authenticationEmail}}",
        "password": "{{authenticationPassword}}",
        "password_confirmation": "{{authenticationPassword}}"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("authenticationUserId", res.getBody().data.relationships.user.data.id);
  }
}

tests {
  test("does not inherit Bearer on a public request", function () {
    const authorization = req.headers.authorization ?? req.headers.Authorization;

    expect(authorization).to.equal(undefined);
  });

  test("returns HTTP 201 without a token", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(201);
    expect(body.data.type).to.equal("sign-ups");
    expect(JSON.stringify(body)).not.to.contain("token");
  });
}
