meta {
  name: Sign Up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "Gabriel Ramos",
        "avatar": "a3f79c0241b86e50d9c217fa6830be45",
        "email": "{{authEmail}}",
        "password": "{{authPassword}}",
        "password_confirmation": "{{authPassword}}"
      }
    }
  }
}
