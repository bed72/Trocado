meta {
  name: Invalid Sign In Document
  type: http
  seq: 5
  tags: [
    authentication
    validation
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-in
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "access-tokens",
      "attributes": {
        "email": "{{authenticationEmail}}"
      }
    }
  }
}

tests {
  test("rejects a sign in without password", function () {
    const error = res.getBody().errors[0];

    expect(res.getStatus()).to.equal(422);
    expect(error.source.pointer).to.equal("/data/attributes/password");
  });
}
