meta {
  name: Duplicate Sign Up
  type: http
  seq: 2
  tags: [
    authentication
    conflict
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "Duplicate Authentication Bruno",
        "email": "{{authenticationEmail}}",
        "password": "{{authenticationPassword}}",
        "password_confirmation": "{{authenticationPassword}}"
      }
    }
  }
}

tests {
  test("returns the JSON:API email conflict", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().errors[0].source.pointer).to.equal("/data/attributes/email");
  });
}
