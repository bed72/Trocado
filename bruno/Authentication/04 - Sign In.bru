meta {
  name: Sign In
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/authentication/sign-in
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "access-tokens",
      "attributes": {
        "email": "{{authEmail}}",
        "password": "{{authPassword}}"
      }
    }
  }
}

script:post-response {
  const token = res.body?.data?.attributes?.token;
  
  if (res.status === 200 && typeof token === 'string' && token.length > 0) {
    bru.setVar('accessToken', token);
    bru.setVar('userId', res.body.data.relationships.user.data.id);
  }
}
