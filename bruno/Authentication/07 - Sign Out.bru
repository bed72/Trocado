meta {
  name: Sign Out
  type: http
  seq: 7
  tags: [
    smoke
    authentication
  ]
}

delete {
  url: {{baseUrl}}/api/authentication/sign-out
  body: none
  auth: inherit
}

tests {
  test("inherits JSON:API negotiation without a content type", function () {
    const accept = req.headers.accept ?? req.headers.Accept;
    const contentType = req.headers["content-type"] ?? req.headers["Content-Type"];

    expect(accept).to.equal("application/vnd.api+json");
    expect(contentType).to.equal(undefined);
  });

  test("inherits the runtime Bearer token", function () {
    const token = bru.getVar("authenticationToken");
    const authorization = req.headers.authorization ?? req.headers.Authorization;

    expect(token).to.be.a("string").and.not.be.empty;
    expect(authorization?.startsWith("Bearer ")).to.equal(true);
    expect(authorization?.slice(7) === token).to.equal(true);
  });

  test("revokes the current token", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
