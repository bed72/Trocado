meta {
  name: Invalid Sign Up
  type: http
  seq: 3
  tags: [
    authentication
    validation
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "sign-ups",
      "attributes": {
        "name": "Invalid Authentication Bruno",
        "email": "{{authenticationEmail}}",
        "password": "{{authenticationPassword}}"
      }
    }
  }
}

tests {
  test("rejects a sign up without password confirmation", function () {
    const error = res.getBody().errors[0];

    expect(res.getStatus()).to.equal(422);
    expect(error.source.pointer).to.equal("/data/attributes/password_confirmation");
  });
}
