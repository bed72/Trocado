meta {
  name: Cleanup Sign In
  type: http
  seq: 9
  tags: [
    smoke
    authentication
    cleanup
  ]
}

post {
  url: {{baseUrl}}/api/authentication/sign-in
  body: json
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "access-tokens",
      "attributes": {
        "email": "{{authenticationEmail}}",
        "password": "{{authenticationPassword}}"
      }
    }
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("authenticationToken", res.getBody().data.attributes.token);
  }
}

tests {
  test("creates a fresh runtime token for authenticated cleanup", function () {
    expect(res.getStatus()).to.equal(200);
    expect(bru.getVar("authenticationToken")).to.be.a("string").and.not.be.empty;
  });
}

docs {
  Obtém uma sessão nova somente depois de o cenário anterior comprovar que o token de SignOut foi revogado. O token continua exclusivamente em runtime e será removido pelo cleanup seguinte.
}
