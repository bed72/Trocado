meta {
  name: Resend Email Verification
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/authentication/email-verification/resend
  body: json
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Content-Type: application/vnd.api+json
}

body:json {
  {
    "data": {
      "type": "email-verifications",
      "attributes": {
        "email": "{{authEmail}}"
      }
    }
  }
}
