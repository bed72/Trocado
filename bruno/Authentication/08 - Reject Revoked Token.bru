meta {
  name: Reject Revoked Token
  type: http
  seq: 8
  tags: [
    smoke
    authentication
    revoked-token
  ]
}

delete {
  url: {{baseUrl}}/api/authentication/sign-out
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 401) {
    bru.deleteVar("authenticationToken");
  }
}

tests {
  test("rejects the revoked token", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("content-type")).to.contain("application/vnd.api+json");
  });
}
